# Copy to .env and fill in. Never commit .env.

# Postgres used by docker compose and the backend
POSTGRES_USER=study_buddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=study_buddy
DATABASE_URL=postgresql+psycopg://study_buddy:change-me@localhost:5432/study_buddy

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Ollama runs on the host so it can use the Mac GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Origins allowed to call the API (Expo web dev server)
CORS_ORIGINS=http://localhost:8081
